        "text": "[aiWorking,setAiWorking]=useState(false)"
      },
      {
        "label": "Original declaration (const)",
        "start": 5293,
        "end": 5330,
        "text": "[codexNote,setCodexNote]=useState('')"
      },
      {
        "label": "Original declaration (const)",
        "start": 5337,
        "end": 5366,
        "text": "aiRequestActive=useRef(false)"
      },
      {
        "label": "Original declaration (const)",
        "start": 5373,
        "end": 5394,
        "text": "aiRequestId=useRef(0)"
      },
      {
        "label": "Original declaration (const)",
        "start": 5454,
        "end": 5500,
        "text": "[agentWorking,setAgentWorking]=useState(false)"
      },
      {
        "label": "Original declaration (const)",
        "start": 5509,
        "end": 5546,
        "text": "[agentNote,setAgentNote]=useState('')"
      },
      {
        "label": "Original declaration (const)",
        "start": 5555,
        "end": 5594,
        "text": "[agentError,setAgentError]=useState('')"
      },
      {
        "label": "Original declaration (const)",
        "start": 5603,
        "end": 5687,
        "text": "[agentUndo,setAgentUndo]=useState<{pageId:string,before:Page,after:Page}|null>(null)"
      },
      {
        "label": "Original declaration (const)",
        "start": 5696,
        "end": 5716,
        "text": "agentRunId=useRef(0)"
      },
      {
        "label": "Original declaration (const)",
        "start": 5725,
        "end": 5760,
        "text": "activePageRef=useRef({view,pageId})"
      },
      {
        "label": "Original lifecycle statement",
        "start": 5761,
        "end": 5797,
        "text": "activePageRef.current={view,pageId};"
      },
      {
        "label": "Original declaration (const)",
        "start": 5805,
        "end": 5889,
        "text": "aiClient=useAIConnection(!!ai||connection||agentWorking,()=>aiRequestActive.current)"
      },
      {
        "label": "Original lifecycle statement",
        "start": 6298,
        "end": 6475,
        "text": "useEffect(()=>{agentRunId.current++;if(lumaAgent.status==='awake')lumaAgent.sleep();setAgentWorking(false);setAgentNote('');setAgentError('');setAgentUndo(null)},[view,pageId]);"
      },
      {
        "label": "Original callback",
        "start": 16131,
        "end": 16709,
        "text": "function commitAgentPage(initial:Page,before:Page,after:Page){\n  const latest=current.current.pages.find(p=>p.id===before.id);\n  if(!loaded||activePageRef.current.view!=='editor'||activePageRef.current.pageId!==before.id||!latest||JSON.stringify(latest)!==JSON.stringify(before))throw new Error('This page changed while Codex was working. I stopped to protect your edits.');\n  const updated={...current.current,pages:current.current.pages.map(p=>p.id===before.id?after:p)};\n  current.current=updated;setData(updated);\n  setAgentUndo({pageId:initial.id,before:initial,after});\n }"
      },
      {
        "label": "Original callback",
        "start": 16711,
        "end": 17931,
        "text": "async function runCodex(snapshot:NonNullable<typeof ai>){\n  if(aiRequestActive.current||lumaAgent.status==='asleep')return;\n  const original=current.current.pages.find(p=>p.id===snapshot.pageId);\n  if(!original){setAiError('This page is no longer available.');return;}\n  aiRequestActive.current=true;setAiWorking(true);setAiError('');setCodexNote('');\n  const requestId=++aiRequestId.current;\n  try{\n   const result=await runPageInitiative({page:original,newId:uid,\n    isActive:()=>aiRequestId.current===requestId&&lumaAgent.status==='awake'&&activePageRef.current.view==='editor'&&activePageRef.current.pageId===original.id,\n    plan:(page,progress)=>lumaAgent.planPage(page,messages=>aiClient.generate(messages.map(message=>`${message.role}: ${message.content}`).join('\\n\\n')),progress),\n    commit:(before,after)=>commitAgentPage(original,before,after)});\n   if(aiRequestId.current!==requestId)return;\n   setCodexNote(result.note||(result.changed?'I added something useful to this page.':'Nothing else needs changing right now.'));\n  }catch(error){if(aiRequestId.current===requestId)setAiError(aiErrorMessage(error))}\n  finally{aiRequestActive.current=false;if(aiRequestId.current===requestId)setAiWorking(false)}\n }"
      },
      {
        "label": "Original callback",
        "start": 17933,
        "end": 19364,
        "text": "async function givePetPageFreedom(){\n  if(agentWorking)return;\n  if(aiRequestActive.current){setAgentError('Another AI request is finishing. Try again in a moment.');return;}\n  const location=activePageRef.current;\n  if(location.view!=='editor')return;\n  const original=current.current.pages.find(p=>p.id===location.pageId);\n  if(!original)return;\n  const run=++agentRunId.current;\n  aiRequestActive.current=true;setAgentWorking(true);setAgentError('');setAgentNote('');lumaAgent.wake();\n  try{\n   const result=await runPageInitiative({page:original,newId:uid,\n    isActive:()=>run===agentRunId.current&&lumaAgent.status==='awake'&&activePageRef.current.view==='editor'&&activePageRef.current.pageId===location.pageId,\n    plan:(page,progress)=>lumaAgent.planPage(page,messages=>aiClient.generate(messages.map(message=>`${message.role}: ${message.content}`).join('\\n\\n')),progress),\n    commit:(before,after)=>commitAgentPage(original,before,after),\n    onPass:pass=>setAgentNote(pass===1?'Choosing what would help here\u2026':`Reviewing my work and choosing the next step (${pass}/3)\u2026`)});\n   if(run!==agentRunId.current)return;\n   setAgentNote(result.note||(result.changed?'I added something useful to this page.':'Nothing else needs changing right now.'));\n  }catch(error){if(run===agentRunId.current)setAgentError(aiErrorMessage(error))}\n  finally{aiRequestActive.current=false;if(run===agentRunId.current)setAgentWorking(false)}\n }"
      },
      {
        "label": "Original callback",
        "start": 19366,
        "end": 19501,
        "text": "function pausePet(){agentRunId.current++;lumaAgent.sleep();setAgentWorking(false);setAgentError('');setAgentNote('Codex is resting.');}"
      },
      {
        "label": "Original callback",
        "start": 19503,
        "end": 20222,
        "text": "function undoPetChanges(){\n  if(!agentUndo||agentWorking)return;\n  const latest=current.current.pages.find(p=>p.id===agentUndo.pageId);\n  if(activePageRef.current.view!=='editor'||activePageRef.current.pageId!==agentUndo.pageId||!latest||JSON.stringify(latest)!==JSON.stringify(agentUndo.after)){\n   setAgentError('This page changed since Codex edited it, so it can\u2019t be undone automatically.');setAgentUndo(null);return;\n  }\n  const restored={...agentUndo.before,updated:new Date().toISOString()};\n  mutate(w=>({...w,pages:w.pages.map(p=>p.id===agentUndo.pageId&&JSON.stringify(p)===JSON.stringify(agentUndo.after)?restored:p)}));\n  setAgentUndo(null);setAgentError('');setAgentNote('Codex\u2019s changes were undone.');\n }"
      },
      {
        "label": "Original callback",
        "start": 20224,
        "end": 20618,
        "text": "function prepareAI(action:string){if(!ai)return;if(aiRequestActive.current){setAiError('A previous request is still finishing. Try again in a moment.');return;}const snapshot={...ai,action};setAi(snapshot);setAiResult('');setAiError('');setCodexNote('');if(action==='Codex'){if(lumaAgent.status==='awake')void runCodex(snapshot);return;}if(action!=='Ask a question')void runAI(snapshot,action)}"
      },
      {
        "label": "Original animated Codex button",
        "start": 51530,
        "end": 51872,
        "text": "<CommandItem className=\"inline-ai-codex\" style={{'--codex-accent':accents[data.settings.accent],'--codex-glow':codexColors[data.settings.accent][0],'--codex-shift':codexColors[data.settings.accent][1]} as CSSProperties} onSelect={()=>prepareAI('Codex')}><span className=\"codex-mark\" aria-hidden=\"true\">\u2726</span><span>Codex</span></CommandItem>"
      },
      {
        "label": "Original host JSX",
        "start": 54145,
        "end": 54244,
        "text": "<AIConnectionSettings client={aiClient} locked={aiWorking||agentWorking||aiRequestActive.current}/>"
      },
      {
        "label": "Original host JSX",
        "start": 54886,
        "end": 55165,
        "text": "<LumaPet pageTitle={view==='editor'?page?.title||'Untitled':undefined} working={agentWorking} note={agentNote} error={agentError} canUndo={!!agentUndo} onFreedom={()=>void givePetPageFreedom()} onPause={pausePet} onUndo={undoPetChanges} onOpenSettings={()=>setConnection(true)}/>"
      }
    ]
  },
