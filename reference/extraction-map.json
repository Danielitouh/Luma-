      },
      {
        "label": "Original declaration (const)",
        "start": 4981,
        "end": 5111,
        "text": "[ai,setAi]=useState<{pageId:string,blockId:string,start:number,end:number,cursor:number,original:string,action:string}|null>(null)"
      },
      {
        "label": "Original declaration (const)",
