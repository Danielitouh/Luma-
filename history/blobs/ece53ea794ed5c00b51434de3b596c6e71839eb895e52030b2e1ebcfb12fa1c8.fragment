import {lumaAgent} from '@/lib/luma-agent';

// Original declaration (const); app/page.tsx:27
uid=()=>crypto.randomUUID?.()||Array.from(crypto.getRandomValues(new Uint8Array(16)),b=>b.toString(16).padStart(2,'0')).join('')

// Original declaration (const); app/page.tsx:29
accents={ember:'#c44d38',ocean:'#2362a4',violet:'#7552aa',forest:'#287764'}

// Original declaration (const); app/page.tsx:30
codexColors={ember:['#eaa488','#d47a9b'],ocean:['#72bad0','#829fd2'],violet:['#c298d5','#8fa5df'],forest:['#87bea3','#8bbec8']} as const

// Original declaration (const); app/page.tsx:35
[ai,setAi]=useState<{pageId:string,blockId:string,start:number,end:number,cursor:number,original:string,action:string}|null>(null)

// Original declaration (const); app/page.tsx:35
[aiQuestion,setAiQuestion]=useState('')

// Original declaration (const); app/page.tsx:35
[aiResult,setAiResult]=useState('')

// Original declaration (const); app/page.tsx:35
[aiError,setAiError]=useState('')

// Original declaration (const); app/page.tsx:35
[aiWorking,setAiWorking]=useState(false)

// Original declaration (const); app/page.tsx:35
[codexNote,setCodexNote]=useState('')

// Original declaration (const); app/page.tsx:35
aiRequestActive=useRef(false)

// Original declaration (const); app/page.tsx:35
aiRequestId=useRef(0)

// Original callback; app/page.tsx:88
async function runCodex(snapshot:NonNullable<typeof ai>){
  if(aiRequestActive.current||lumaAgent.status==='asleep')return;
  const original=current.current.pages.find(p=>p.id===snapshot.pageId);
  if(!original){setAiError('This page is no longer available.');return;}
  aiRequestActive.current=true;setAiWorking(true);setAiError('');setCodexNote('');
  const requestId=++aiRequestId.current,baseline=JSON.stringify(original);
  try{
   const plan=await lumaAgent.planPage(original,messages=>puter.generate(messages.map(message=>`${message.role}: ${message.content}`).join('\n\n')));
   if(aiRequestId.current!==requestId||lumaAgent.getSnapshot().status==='asleep')return;
   const latest=current.current.pages.find(p=>p.id===snapshot.pageId);
   if(!latest||JSON.stringify(latest)!==baseline)throw new Error('The page changed while Codex was thinking. Reopen it from the current page.');
   if(plan.changes.length){
    const updated=applyPagePlan(original,plan,uid);
    mutate(w=>({...w,pages:w.pages.map(p=>p.id===snapshot.pageId&&JSON.stringify(p)===baseline?updated:p)}));
   }
   setCodexNote(plan.note|| (plan.changes.length?'Codex updated this page.':'Codex found nothing to change on this page.'));
  }catch(error){if(aiRequestId.current===requestId)setAiError(puterError(error))}
  finally{aiRequestActive.current=false;if(aiRequestId.current===requestId)setAiWorking(false)}
 }

// Original callback; app/page.tsx:107
function prepareAI(action:string){if(!ai)return;if(aiRequestActive.current){setAiError('A previous request is still finishing. Try again in a moment.');return;}const snapshot={...ai,action};setAi(snapshot);setAiResult('');setAiError('');setCodexNote('');if(action==='Codex'){if(lumaAgent.status==='awake')void runCodex(snapshot);return;}if(action!=='Ask a question')void runAI(snapshot,action)}

// Original animated Codex button; app/page.tsx:135
<CommandItem className="inline-ai-codex" style={{'--codex-accent':accents[data.settings.accent],'--codex-glow':codexColors[data.settings.accent][0],'--codex-shift':codexColors[data.settings.accent][1]} as CSSProperties} onSelect={()=>prepareAI('Codex')}><span className="codex-mark" aria-hidden="true">✦</span><span>Codex</span></CommandItem>

