[aiWorking,setAiWorking]=useState(false)

// Original declaration (const); app/page.tsx:36
[codexNote,setCodexNote]=useState('')

// Original declaration (const); app/page.tsx:36
aiRequestActive=useRef(false)

// Original declaration (const); app/page.tsx:36
aiRequestId=useRef(0)

// Original declaration (const); app/page.tsx:38
[agentWorking,setAgentWorking]=useState(false)

// Original declaration (const); app/page.tsx:39
[agentNote,setAgentNote]=useState('')

// Original declaration (const); app/page.tsx:40
[agentError,setAgentError]=useState('')

