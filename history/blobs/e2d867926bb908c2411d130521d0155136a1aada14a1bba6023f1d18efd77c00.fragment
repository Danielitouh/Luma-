function prepareAI(action:string){if(!ai)return;if(aiRequestActive.current){setAiError('A previous request is still finishing. Try again in a moment.');return;}const snapshot={...ai,action};setAi(snapshot);setAiResult('');setAiError('');if(action!=='Ask a question')void runAI(snapshot,action)}
